rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
  function owner(cid) { return admin() && get(/databases/$(database)/documents/classes/$(cid)).data.get('deleted',false) == false && get(/databases/$(database)/documents/classes/$(cid)).data.ownerId == request.auth.uid; }
  function active(cid,sid) { return signedIn() && get(/databases/$(database)/documents/classes/$(cid)).data.get('deleted',false) == false && (owner(cid) || get(/databases/$(database)/documents/classes/$(cid)).data.get('published',true) == true) && get(/databases/$(database)/documents/classes/$(cid)).data.activeSessionId == sid; }
  function promptVisible(cid,sid,pid) { return active(cid,sid) && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/prompts/$(pid)).data.published == true; }
  function answerVisible(cid,sid,pid,aid) { return get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/prompts/$(pid)/answers/$(aid)).data.published == true; }
  match /classes/{cid} {
   allow get: if owner(cid) || (signedIn() && resource.data.get('deleted',false) == false && resource.data.get('published',true) == true);
   allow list: if admin() && resource.data.ownerId == request.auth.uid;
   allow create: if admin() && request.resource.data.keys().hasOnly(['id','title','ownerId','activeSessionId','sessionNumber','createdAt','sessionStartedAt']) && request.resource.data.id == cid && request.resource.data.ownerId == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 && request.resource.data.activeSessionId is string && request.resource.data.activeSessionId.size() > 0 && request.resource.data.sessionNumber == 1 && request.resource.data.createdAt is number && request.resource.data.sessionStartedAt is number;
   allow update: if owner(cid) && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published']) && request.resource.data.published is bool)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','published']) && request.resource.data.deleted == true && request.resource.data.published == false)
    ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']) && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionLabel']) && request.resource.data.sessionLabel is string && request.resource.data.sessionLabel.size() > 0 && request.resource.data.sessionLabel.size() <= 100)
    ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionStartedAt']) && request.resource.data.sessionStartedAt is number)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSessionId','sessionNumber','sessionStartedAt','sessionLabel']) && request.resource.data.activeSessionId is string && request.resource.data.activeSessionId.size() > 0 && request.resource.data.activeSessionId != resource.data.activeSessionId && request.resource.data.sessionNumber == resource.data.sessionNumber + 1 && request.resource.data.sessionStartedAt is number && request.resource.data.get('sessionLabel','') == '')
   );
   match /sessions/{sid} {
    allow read: if owner(cid);
    allow create, update: if owner(cid) && request.resource.data.keys().hasOnly(['number','startedAt','label']) && (request.resource.data.get('number',null) == null || (request.resource.data.number is int && request.resource.data.number > 0)) && (request.resource.data.get('startedAt',null) == null || request.resource.data.startedAt is number) && request.resource.data.get('label','') is string && request.resource.data.get('label','').size() <= 100;
   }
   // Spark: submissions are immutable UID records. Only the owner can
   // aggregate private responses and publish a summary from the management UI.
   match /sessions/{sid}/polls/{pid} {
    function validPoll(p) {
     return p.keys().hasOnly(['id','kind','title','type','options','accepting','resultsPublished','hasResponses','published','chartType','createdAt','updatedAt'])
       && p.id == pid && p.kind == 'poll'
       && p.title is string && p.title.size() > 0 && p.title.size() <= 1000
       && p.type in ['single','multiple','text'] && p.options is list
       && p.accepting is bool && p.resultsPublished is bool && p.get('hasResponses',false) is bool
       && p.get('published',true) is bool && p.get('chartType','bar') in ['bar','pie']
       && p.createdAt is number && p.updatedAt is number
       && (p.type == 'text' ? p.options.size() == 0 : (p.options.size() >= 2 && p.options.size() <= 8 && p.options.toSet().size() == p.options.size()))
       && (p.options.size() <= 0 || (p.options[0] is string && p.options[0].size() > 0 && p.options[0].size() <= 100))
       && (p.options.size() <= 1 || (p.options[1] is string && p.options[1].size() > 0 && p.options[1].size() <= 100))
       && (p.options.size() <= 2 || (p.options[2] is string && p.options[2].size() > 0 && p.options[2].size() <= 100))
       && (p.options.size() <= 3 || (p.options[3] is string && p.options[3].size() > 0 && p.options[3].size() <= 100))
       && (p.options.size() <= 4 || (p.options[4] is string && p.options[4].size() > 0 && p.options[4].size() <= 100))
       && (p.options.size() <= 5 || (p.options[5] is string && p.options[5].size() > 0 && p.options[5].size() <= 100))
       && (p.options.size() <= 6 || (p.options[6] is string && p.options[6].size() > 0 && p.options[6].size() <= 100))
       && (p.options.size() <= 7 || (p.options[7] is string && p.options[7].size() > 0 && p.options[7].size() <= 100));
    }
    function allowedChoices(p) { return p.options.size() == 1 ? [0] : (p.options.size() == 2 ? [0,1] : (p.options.size() == 3 ? [0,1,2] : (p.options.size() == 4 ? [0,1,2,3] : (p.options.size() == 5 ? [0,1,2,3,4] : (p.options.size() == 6 ? [0,1,2,3,4,5] : (p.options.size() == 7 ? [0,1,2,3,4,5,6] : (p.options.size() == 8 ? [0,1,2,3,4,5,6,7] : ([])))))))); }
    function validResponse(p,r,uid) {
     return r.keys().hasOnly(['userId','name','text','choices','createdAt'])
       && r.userId == uid && r.name is string && r.name.size() <= 40
       && r.text is string && r.choices is list && r.createdAt is number
       && (p.type == 'text'
         ? (r.text.size() > 0 && r.text.size() <= 1000 && r.choices.size() == 0)
         : (r.text == '' && r.choices.size() > 0 && r.choices.size() <= p.options.size()
           && (p.type != 'single' || r.choices.size() == 1)
           && r.choices.toSet().size() == r.choices.size() && r.choices.toSet().hasOnly(allowedChoices(p))))
       && (r.choices.size() <= 0 || r.choices[0] is int)
       && (r.choices.size() <= 1 || r.choices[1] is int)
       && (r.choices.size() <= 2 || r.choices[2] is int)
       && (r.choices.size() <= 3 || r.choices[3] is int)
       && (r.choices.size() <= 4 || r.choices[4] is int)
       && (r.choices.size() <= 5 || r.choices[5] is int)
       && (r.choices.size() <= 6 || r.choices[6] is int)
       && (r.choices.size() <= 7 || r.choices[7] is int);
    }
    function validSummary(p,a) {
     return a.keys().hasOnly(['responseCount','counts'])
       && a.responseCount is int && a.responseCount >= 0
       && a.counts is list && a.counts.size() == p.options.size()
       && (a.counts.size() <= 0 || (a.counts[0] is int && a.counts[0] >= 0 && a.counts[0] <= a.responseCount))
       && (a.counts.size() <= 1 || (a.counts[1] is int && a.counts[1] >= 0 && a.counts[1] <= a.responseCount))
       && (a.counts.size() <= 2 || (a.counts[2] is int && a.counts[2] >= 0 && a.counts[2] <= a.responseCount))
       && (a.counts.size() <= 3 || (a.counts[3] is int && a.counts[3] >= 0 && a.counts[3] <= a.responseCount))
       && (a.counts.size() <= 4 || (a.counts[4] is int && a.counts[4] >= 0 && a.counts[4] <= a.responseCount))
       && (a.counts.size() <= 5 || (a.counts[5] is int && a.counts[5] >= 0 && a.counts[5] <= a.responseCount))
       && (a.counts.size() <= 6 || (a.counts[6] is int && a.counts[6] >= 0 && a.counts[6] <= a.responseCount))
       && (a.counts.size() <= 7 || (a.counts[7] is int && a.counts[7] >= 0 && a.counts[7] <= a.responseCount));
    }
    function freshOwnResponse(p) {
     let response = /databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)/responses/$(request.auth.uid);
     return !exists(response) && validResponse(p,getAfter(response).data,request.auth.uid);
    }
    allow get: if owner(cid) || (active(cid,sid) && resource.data.get('published',true) == true);
    allow list: if owner(cid) || (active(cid,sid) && resource.data.published == true);
    allow create: if owner(cid) && active(cid,sid) && validPoll(request.resource.data)
      && request.resource.data.accepting == false && request.resource.data.resultsPublished == false
      && request.resource.data.hasResponses == false;
    allow update: if active(cid,sid) && (
      (owner(cid) && validPoll(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepting','resultsPublished','published','chartType','updatedAt'])
        || (!resource.data.accepting && !resource.data.get('hasResponses',false)
          && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)/results/summary).data.responseCount == 0
          && request.resource.data.hasResponses == false && request.resource.data.accepting == false && request.resource.data.resultsPublished == false)
      ))
      || (resource.data.get('published',true) == true && resource.data.accepting == true
        && request.resource.data.hasResponses == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasResponses'])
        && freshOwnResponse(resource.data))
    );
    allow delete: if owner(cid) && active(cid,sid);
    function visiblePoll() { return active(cid,sid) && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data.get('published',true) == true; }
    match /responses/{uid} {
     allow get: if owner(cid) || (visiblePoll() && request.auth.uid == uid);
     allow list: if owner(cid);
     allow create: if visiblePoll() && request.auth.uid == uid
       && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data.accepting == true
       && validResponse(get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data,request.resource.data,uid)
       && getAfter(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data.hasResponses == true;
    }
    match /results/{resultId} {
     allow read: if owner(cid) || (visiblePoll() && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data.resultsPublished == true);
     allow create: if resultId == 'summary' && owner(cid) && active(cid,sid)
       && validSummary(getAfter(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data,request.resource.data)
       && request.resource.data.responseCount == 0;
     allow update: if resultId == 'summary' && owner(cid) && active(cid,sid)
       && validSummary(getAfter(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/polls/$(pid)).data,request.resource.data)
       && request.resource.data.responseCount >= resource.data.responseCount;
    }
   }
   match /sessions/{sid}/questions/{qid} {
    allow update: if owner(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published']) && request.resource.data.published is bool;
    allow delete: if owner(cid);
    allow read: if owner(cid) || (active(cid,sid) && resource.data.published == true);
    allow create: if active(cid,sid) && request.resource.data.keys().hasOnly(['id','body','name','authorId','createdAt','published']) && request.resource.data.published == true && request.resource.data.id == qid && request.resource.data.authorId == request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000 && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.createdAt is number;
   }
   match /sessions/{sid}/prompts/{pid} {
    allow read: if owner(cid) || (active(cid,sid) && resource.data.published == true);
    allow create: if owner(cid) && active(cid,sid) && request.resource.data.keys().hasOnly(['id','body','accepting','createdAt','published','commentsEnabled']) && request.resource.data.id == pid && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000 && request.resource.data.accepting == false && request.resource.data.published == true && request.resource.data.commentsEnabled is bool && request.resource.data.createdAt is number;
    allow update: if owner(cid) && active(cid,sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepting','published','commentsEnabled']) && request.resource.data.accepting is bool && request.resource.data.get('published',true) is bool && request.resource.data.get('commentsEnabled',true) is bool;
    allow delete: if owner(cid) && active(cid,sid);
    match /answers/{aid} {
     allow read: if owner(cid) || (promptVisible(cid,sid,pid) && resource.data.published == true);
     allow update: if owner(cid) && active(cid,sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published']) && request.resource.data.published is bool;
     allow delete: if owner(cid) && active(cid,sid);
     allow create: if promptVisible(cid,sid,pid) && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/prompts/$(pid)).data.accepting == true && request.resource.data.keys().hasOnly(['id','body','name','authorId','createdAt','published']) && request.resource.data.published == true && request.resource.data.id == aid && request.resource.data.authorId == request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000 && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.createdAt is number;
    }
    match /comments/{commentId} {
     allow read: if owner(cid) || (promptVisible(cid,sid,pid) && answerVisible(cid,sid,pid,resource.data.answerId));
     allow create: if promptVisible(cid,sid,pid) && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/prompts/$(pid)).data.get('commentsEnabled',true) == true && request.resource.data.keys().hasOnly(['id','answerId','body','name','authorId','createdAt']) && request.resource.data.id == commentId && request.resource.data.authorId == request.auth.uid && request.resource.data.answerId is string && answerVisible(cid,sid,pid,request.resource.data.answerId) && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000 && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.createdAt is number;
    }
    match /answerVotes/{vid} {
     allow read: if owner(cid) || promptVisible(cid,sid,pid);
     allow create: if promptVisible(cid,sid,pid) && request.resource.data.keys().hasOnly(['answerId','userId']) && request.resource.data.userId == request.auth.uid && request.resource.data.answerId is string && vid == request.resource.data.answerId + '_' + request.auth.uid && answerVisible(cid,sid,pid,request.resource.data.answerId);
     allow delete: if active(cid,sid) && resource.data.userId == request.auth.uid;
    }
   }
   match /sessions/{sid}/votes/{vid} {
    allow read: if active(cid,sid) || owner(cid);
    allow create: if active(cid,sid) && request.resource.data.keys().hasOnly(['questionId','userId']) && request.resource.data.userId == request.auth.uid && request.resource.data.questionId is string && vid == request.resource.data.questionId + '_' + request.auth.uid && get(/databases/$(database)/documents/classes/$(cid)/sessions/$(sid)/questions/$(request.resource.data.questionId)).data.published == true;
    allow delete: if active(cid,sid) && resource.data.userId == request.auth.uid;
   }
  }
 }
}
