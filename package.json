{
  "name": "odilsap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-odilsap --only firestore \"node --test tests/security/*.mjs\"",
    "test:polls:emulator": "firebase emulators:exec --project demo-odilsap --only firestore \"node --test tests/security/*.mjs tests/emulator/*.mjs\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
